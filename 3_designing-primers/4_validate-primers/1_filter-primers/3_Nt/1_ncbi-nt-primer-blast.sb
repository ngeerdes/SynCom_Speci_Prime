#!/bin/bash

# Copy/paste this job script into a text file and submit with the command:
#    sbatch thefilename

#SBATCH --time=48:00:00   # walltime limit (HH:MM:SS)
#SBATCH --nodes=1   # number of nodes
#SBATCH --ntasks-per-node=36   # 36 processor core(s) per node 
#SBATCH --job-name="primers-nt-blast"
#SBATCH --mail-user=ngeerdes@iastate.edu   # email address
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --output="slurm-primers-nt-blast-updated.out" # job standard output file (%j replaced by job id)

# Define an array of isolate IDs 

isolates=("PvR021" "PvR079" "PvR083" "PvR122" "PvR147") 

# Loop through each isolate and execute the Python script 
for isolates in "${isolates[@]}" ; do 
    echo "Running BLAST for isolate: $isolates" 
    blastn -task blastn-short \
            -query "../../validation/refsoil/filtered/${isolates}.filtered.syncom.refsoil.primers.fasta" \
            -db /work/adina/ngeerdes/databases/nacbi-nt/nt \
            -out "../../validation/nt/blast-out-2/${isolates}.nt.blast.out" \
            -outfmt 6 \
            -num_threads 36 
done